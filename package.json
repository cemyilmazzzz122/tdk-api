{
  "name": "tdk-api-wrapper",
  "version": "1.7.0",
  "description": "TDK (Türk Dil Kurumu) unofficial live data API wrapper and MCP server for Node.js",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "tdk": "dist/cli.js",
    "tdk-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --clean --shims",
    "test": "node test/morphology.test.js && node test/grammar.test.js && node test/proofread.test.js && node test/tools.test.js"
  },
  "keywords": [
    "tdk",
    "sozluk",
    "api",
    "turkish",
    "dictionary",
    "turkce",
    "sozluk.gov.tr",
    "spell-check",
    "morphology",
    "kubbealti",
    "nisanyan",
    "wiktionary",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "author": "cemyilmazzzz122 <cemyleo12@icloud.com> (https://github.com/cemyilmazzzz122)",
  "license": "MIT",
  "homepage": "https://github.com/cemyilmazzzz122/tdk-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cemyilmazzzz122/tdk-api.git"
  },
  "bugs": {
    "url": "https://github.com/cemyilmazzzz122/tdk-api/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
